    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const out = $json.output || {};\nlet text = '';\ntry { text = String($('Extrair texto do PDF').item.json.text || ''); } catch (e) { text = ''; }\nlet arquivo = '';\ntry {\n  const bin = $('Receber nota fiscal').item.binary || {};\n  const k = Object.keys(bin)[0];\n  arquivo = k ? (bin[k].fileName || '') : '';\n} catch (e) { arquivo = ''; }\n\nconst clean = (v) => (v === null || v === undefined) ? '' : String(v).trim();\nconst pendencias = [];\n\nfunction parseMoney(s) {\n  let t = clean(s).replace(/[^0-9,.-]/g, '');\n  if (!t) return null;\n  const hasComma = t.indexOf(',') >= 0;\n  const hasDot = t.indexOf('.') >= 0;\n  if (hasComma && hasDot) {\n    if (t.lastIndexOf(',') > t.lastIndexOf('.')) { t = t.replace(/\\./g, '').replace(',', '.'); }\n    else { t = t.replace(/,/g, ''); }\n  } else if (hasComma) {\n    t = t.replace(',', '.');\n  } else if (hasDot && /^\\d{1,3}(\\.\\d{3})+$/.test(t)) {\n    t = t.replace(/\\./g, '');\n  }\n  const n = Number(t);\n  return isFinite(n) ? n : null;\n}\n\nfunction validCnpj(c) {\n  if (c.length !== 14 || /^(\\d)\\1+$/.test(c)) return false;\n  const calc = (n) => {\n    let s = 0;\n    let p = n - 7;\n    for (let i = 0; i < n; i++) { s += Number(c[i]) * p; p--; if (p < 2) p = 9; }\n    const r = s % 11;\n    return r < 2 ? 0 : 11 - r;\n  };\n  return calc(12) === Number(c[12]) && calc(13) === Number(c[13]);\n}\n\nfunction toIso(s) {\n  const t = clean(s);\n  let m = t.match(/^(\\d{4})-(\\d{2})-(\\d{2})/);\n  let y, mo, d;\n  if (m) { y = m[1]; mo = m[2]; d = m[3]; }\n  else {\n    m = t.match(/^(\\d{2})[\\/.-](\\d{2})[\\/.-](\\d{4})$/);\n    if (!m) return '';\n    d = m[1]; mo = m[2]; y = m[3];\n  }\n  const dt = new Date(y + '-' + mo + '-' + d + 'T00:00:00Z');\n  if (isNaN(dt.getTime()) || dt.toISOString().slice(0, 10) !== (y + '-' + mo + '-' + d)) return '';\n  return y + '-' + mo + '-' + d;\n}\n\nfunction analisarValoresMonetarios(t) {\n  const re = /R\\$\\s*(\\d[\\d.,]*\\d|\\d)/g;\n  const encontrados = [];\n  let malformado = false;\n  let m;\n  while ((m = re.exec(t)) !== null) {\n    const tok = m[1];\n    let n = null;\n    if (/^(\\d{1,3}(\\.\\d{3})+|\\d+)(,\\d{2})?$/.test(tok)) {\n      n = Number(tok.replace(/\\./g, '').replace(',', '.'));\n    }\n    if (n === null || !isFinite(n)) malformado = true;\n    else encontrados.push({ digitos: tok.replace(/\\D/g, ''), centavos: Math.round(n * 100) });\n  }\n  let divergente = malformado;\n  for (let i = 0; i < encontrados.length && !divergente; i++) {\n    for (let j = i + 1; j < encontrados.length; j++) {\n      if (encontrados[i].digitos === encontrados[j].digitos && encontrados[i].centavos !== encontrados[j].centavos) { divergente = true; break; }\n    }\n  }\n  return divergente;\n}\n\nconst fornecedor = clean(out.fornecedor);\nconst cnpj = clean(out.cnpj).replace(/\\D/g, '');\nconst numero = clean(out.numero_documento);\nconst valor = parseMoney(out.valor_total);\nconst vencimento = toIso(out.data_vencimento);\nconst textoSemEspaco = text.replace(/\\s+/g, '');\nconst textoDigitos = text.replace(/\\D/g, '');\n\nif (text.replace(/\\s+/g, '').length < 30) {\n  pendencias.push('PDF sem texto legível (possível documento digitalizado/imagem): conferir manualmente');\n}\nif (!fornecedor) pendencias.push('Fornecedor ausente');\nelse if (text && !text.toLowerCase().replace(/\\s+/g, ' ').includes(fornecedor.toLowerCase().replace(/\\s+/g, ' '))) {\n  pendencias.push('Fornecedor extraído não aparece literalmente no documento');\n}\nif (!cnpj) pendencias.push('CNPJ ausente');\nelse {\n  if (!validCnpj(cnpj)) pendencias.push('CNPJ inválido (dígitos verificadores não conferem)');\n  if (text && !textoDigitos.includes(cnpj)) pendencias.push('CNPJ extraído não aparece no documento');\n}\nif (!numero) pendencias.push('Número do documento ausente');\nelse if (text && !textoSemEspaco.includes(numero.replace(/\\s+/g, ''))) {\n  pendencias.push('Número do documento extraído não aparece no documento');\n}\nif (valor === null) pendencias.push('Valor total ausente ou ilegível');\nelse {\n  if (valor <= 0) pendencias.push('Valor total deve ser maior que zero');\n  const centavos = String(Math.round(valor * 100));\n  const inteiro = String(Math.round(valor));\n  if (text && !textoDigitos.includes(centavos) && !textoDigitos.includes(inteiro)) {\n    pendencias.push('Valor total extraído não aparece no documento');\n  }\n}\nif (text && analisarValoresMonetarios(text)) {\n  pendencias.push('Divergência entre valores monetários encontrados no documento — revisão humana obrigatória');\n}\nif (!clean(out.data_vencimento)) pendencias.push('Data de vencimento ausente');\nelse if (!vencimento) pendencias.push('Data de vencimento em formato inválido');\nelse {\n  const p = vencimento.split('-');\n  const variantes = [p[2] + '/' + p[1] + '/' + p[0], p[2] + '-' + p[1] + '-' + p[0], p[2] + '.' + p[1] + '.' + p[0], vencimento];\n  if (text && !variantes.some((v) => textoSemEspaco.includes(v))) {\n    pendencias.push('Data de vencimento extraída não aparece no documento');\n  }\n}\n\nconst cnpjFmt = cnpj.length === 14\n  ? cnpj.replace(/^(\\d{2})(\\d{3})(\\d{3})(\\d{4})(\\d{2})$/, '$1.$2.$3/$4-$5')\n  : cnpj;\n\nreturn {\n  json: {\n    status: pendencias.length === 0 ? 'Validado' : 'Revisão necessária',\n    fornecedor,\n    cnpj: cnpjFmt,\n    numero_documento: numero,\n    valor_total: valor,\n    data_vencimento: vencimento,\n    arquivo,\n    pendencias,\n    pendencias_texto: pendencias.join(' | '),\n    registrado_em: $now.toFormat('yyyy-MM-dd HH:mm'),\n  },\n};"
      },
