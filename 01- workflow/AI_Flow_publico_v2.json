      "id": "ad01ab42-d1b7-4e8e-8533-09a004ca9f37",
      "name": "Modelo Gemini",
      "type": "@n8n/n8n-nodes-langchain.lmChatGoogleGemini",
      "typeVersion": 1.2,
      "position": [
        576,
        448
      ],
